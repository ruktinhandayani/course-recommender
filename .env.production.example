CRE_ML_ARTIFACT_DIR=course_recommender_artifacts_final
CRE_ML_DATA_DIR=data
CRE_ML_EXPORT_DIR=course_recommender_artifacts_final/export
CRE_ML_MODEL_VERSION=cre-lstm-attention-h2-seed42-fullmask-v1

# Generate long random values before deployment.
CRE_ML_API_KEY=replace-with-long-random-api-key
CRE_ML_HMAC_SECRET=replace-with-long-random-hmac-secret
CRE_ML_SESSION_SECRET=replace-with-long-random-session-secret

CRE_ML_TIMESTAMP_TOLERANCE_SECONDS=60
CRE_ML_REQUIRE_AUTH=true

# Keep enabled only when deploying the standalone admin console.
CRE_ML_ENABLE_TEST_UI=true
CRE_ML_TEST_UI_ORIGINS=https://cre.your-domain.example

CRE_ML_ADMIN_USERNAME=admin
# Generate with:
# docker compose run --rm cre-ml-service python scripts/hash_admin_password.py
CRE_ML_ADMIN_PASSWORD_HASH='pbkdf2_sha256$replace$safely'

# Must be true when served over HTTPS.
CRE_ML_SESSION_COOKIE_SECURE=true

# Browser-facing backend URL baked into the frontend image.
# Use the public HTTPS API/admin-console origin reachable by the browser.
CRE_UI_API_BASE_URL=https://cre.your-domain.example
